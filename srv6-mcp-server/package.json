{
  "name": "@srv6md/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the srv6.md knowledge base: docs search, endpoint behaviors, and vendor config templates",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "srv6-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "srv6",
    "mcp",
    "segment-routing",
    "ipv6",
    "networking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldaninavas/srv6.md"
  },
  "files": [
    "dist/",
    "knowledge/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
